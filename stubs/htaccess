<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=308]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

# Let browsers cache the static images that Laravel's public disk serves under /storage/media/ for a week,
# and forbid type sniffing as the app does for every media response. The file names carry the media version,
# so a changed image always gets a new address. The path test assumes the site is at the domain root.
<IfModule mod_headers.c>
    <FilesMatch "\.(webp|jpe?g|png|gif|avif)$">
        <If "%{REQUEST_URI} =~ m#^/storage/media/#">
            Header set Cache-Control "public, max-age=604800"
            Header set X-Content-Type-Options "nosniff"
        </If>
    </FilesMatch>
</IfModule>

# Hata's built assets under /vendor/hata/assets/ (published by composer) carry a content hash in their names, so a
# changed file always gets a new address: browsers keep them for a year without asking again.
<IfModule mod_headers.c>
    <If "%{REQUEST_URI} =~ m#^/vendor/hata/assets/#">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </If>
</IfModule>
