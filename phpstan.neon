includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    paths:
        - src/
        - config/
        - database/
        - routes/
        - workbench/app/

    level: 7

    configDirectories:
        - config/

    ignoreErrors:
        -
            # A test helper for sites and modules: used by their tests, which are not analysed.
            identifier: trait.unused
            path: src/Testing/AssertsListQueries.php
