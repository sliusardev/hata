{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "sliusardev/hata",
    "type": "library",
    "description": "Hata: an admin panel and CMS for Laravel (users, roles, site settings, media library, content).",
    "keywords": [
        "laravel",
        "admin",
        "cms",
        "livewire"
    ],
    "license": "proprietary",
    "require": {
        "php": "^8.4",
        "ext-intl": "*",
        "intervention/image": "^4.2",
        "laravel/fortify": "^1.37.2",
        "laravel/framework": "^13.17",
        "league/flysystem-aws-s3-v3": "^3.35",
        "livewire/blaze": "^1.0",
        "livewire/flux": "~2.21.0",
        "livewire/livewire": "^4.4",
        "spatie/laravel-permission": "^8.4",
        "symfony/html-sanitizer": "^8.1"
    },
    "require-dev": {
        "fakerphp/faker": "^1.24",
        "larastan/larastan": "^3.9",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.9.3",
        "orchestra/testbench": "^11.3",
        "pestphp/pest": "^5.3",
        "pestphp/pest-plugin-laravel": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "Hata\\": "src/",
            "Hata\\Database\\Factories\\": "database/factories/",
            "Hata\\Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\": "workbench/app/",
            "Database\\Factories\\": "workbench/database/factories/",
            "Database\\Seeders\\": "workbench/database/seeders/",
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "lint": [
            "pint --parallel"
        ],
        "lint:check": [
            "pint --parallel --test"
        ],
        "ci:check": [
            "Composer\\Config::disableProcessTimeout",
            "@test"
        ],
        "types:check": [
            "phpstan analyse"
        ],
        "test": [
            "Composer\\Config::disableProcessTimeout",
            "@lint:check",
            "@types:check",
            "pest"
        ],
        "post-autoload-dump": [
            "@php vendor/bin/testbench package:discover --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Hata\\HataServiceProvider"
            ]
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
